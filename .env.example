# =====================================================================
# Copiar este archivo como ".env" y completar con los valores reales.
# NUNCA subir el archivo ".env" real a un repositorio público.
# =====================================================================

# Token de acceso de larga duración de la cuenta de Instagram Business/Creator
ACCESS_TOKEN=tu_access_token_aqui

# ID de la cuenta de Instagram Business (NO es el ID de la página de Facebook)
IG_ACCOUNT_ID=tu_ig_account_id_aqui

# Versión de la Graph API de Meta a utilizar
GRAPH_API_VERSION=v21.0

# Ruta del archivo de base de datos SQLite
DATABASE_PATH=instagram_autopilot.db

# Minutos entre cada revisión del scheduler
SCHEDULER_INTERVAL_MINUTES=5

# Segundos entre cada consulta de estado de un contenedor de media (polling)
MEDIA_STATUS_POLL_INTERVAL_SECONDS=10

# Intentos máximos antes de marcar un contenedor como fallido por timeout
# (30 intentos x 10 segundos = 5 minutos máximos de espera)
MEDIA_STATUS_MAX_ATTEMPTS=30

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Archivo donde se guardan los logs
LOG_FILE=autopilot.log
